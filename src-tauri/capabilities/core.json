{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "core",
  "description": "The hidden core web view: events, dialogs, opening files and links, updates, restart.",
  "windows": ["core"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:default"
  ]
}
