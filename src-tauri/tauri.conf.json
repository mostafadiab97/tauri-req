{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reqochet-tauri",
  "version": "0.1.0",
  "identifier": "org.reqochet.tauri",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": { "../upstream/config/": "config/", "../upstream/resources/": "resources/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACED-IN-CI",
      "endpoints": ["https://github.com/OWNER/tauri-req/releases/latest/download/latest.json"]
    }
  }
}
